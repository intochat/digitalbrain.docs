{
  "gestures": ["tap", "drag", "hover"],
  "tweenProperties": ["x", "y", "scale", "rotation", "opacity"],
  "tweenCurves": ["linear", "easeIn", "easeOut", "easeInOut"],
  "treeKinds": ["selector", "sequence", "repeat", "condition", "wait", "moveTo", "scale", "fade", "pulse"],
  "treeTasks": [
    { "kind": "wait", "minSeconds": 0, "maxSeconds": 60, "minValue": 0, "maxValue": 0 },
    { "kind": "moveTo", "minSeconds": 0, "maxSeconds": 10, "minValue": -4096, "maxValue": 4096 },
    { "kind": "scale", "minSeconds": 0, "maxSeconds": 10, "minValue": 0.1, "maxValue": 4 },
    { "kind": "fade", "minSeconds": 0, "maxSeconds": 10, "minValue": 0, "maxValue": 1 },
    { "kind": "pulse", "minSeconds": 0, "maxSeconds": 10, "minValue": 0, "maxValue": 1 }
  ],
  "reservedBlackboardKeys": ["running", "attention"],
  "maxTreeNodes": 256,
  "maxTreeDepth": 16,
  "nodes": [
    { "type": "circle", "parameters": [
