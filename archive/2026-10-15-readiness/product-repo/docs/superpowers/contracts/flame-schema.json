      { "key": "color", "kind": "color", "required": false, "choices": [] } ] },
    { "type": "rect", "parameters": [
      { "key": "width", "kind": "number", "required": false, "choices": [] },
      { "key": "height", "kind": "number", "required": false, "choices": [] },
      { "key": "color", "kind": "color", "required": false, "choices": [] },
      { "key": "corner", "kind": "number", "required": false, "choices": [] } ] },
    { "type": "text", "parameters": [
      { "key": "text", "kind": "text", "required": true, "choices": [] },
      { "key": "size", "kind": "number", "required": false, "choices": [] },
      { "key": "color", "kind": "color", "required": false, "choices": [] },
      { "key": "align", "kind": "choice", "required": false, "choices": ["left", "center", "right"] } ] },
    { "type": "sprite", "parameters": [
      { "key": "src", "kind": "text", "required": true, "choices": [] },
      { "key": "width", "kind": "number", "required": false, "choices": [] },
      { "key": "height", "kind": "number", "required": false, "choices": [] } ] },
    { "type": "path", "parameters": [
      { "key": "d", "kind": "text", "required": true, "choices": [] } ] },
    { "type": "particles", "parameters": [
      { "key": "count", "kind": "number", "required": false, "choices": [] },
