      { "key": "color", "kind": "color", "required": false, "choices": [] } ] },
    { "type": "group", "parameters": [] },
    { "type": "activity_ring", "parameters": [
      { "key": "items", "kind": "json", "required": false, "choices": [] },
      { "key": "radius", "kind": "number", "required": false, "choices": [] } ] },
    { "type": "sphere", "parameters": [
      { "key": "icon", "kind": "text", "required": true, "choices": [] },
      { "key": "title", "kind": "text", "required": false, "choices": [] },
      { "key": "description", "kind": "text", "required": false, "choices": [] },
      { "key": "blackboard", "kind": "json", "required": false, "choices": [] },
